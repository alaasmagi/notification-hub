  --shadow-md: 0px 2px 4px -1px rgb(8 10 15 / 0.06), 0px 6px 16px -4px rgb(8 10 15 / 0.12);
  --shadow-lg: 0px 4px 8px -2px rgb(8 10 15 / 0.06), 0px 16px 40px -8px rgb(8 10 15 / 0.18);
