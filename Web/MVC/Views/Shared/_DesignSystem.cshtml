}
[data-theme="light"] {
  color-scheme: light;
  --color-bg-canvas: var(--neutral-50);
  --color-bg-surface: var(--neutral-0);
  --color-bg-raised: var(--neutral-0);
  --color-bg-sunken: var(--neutral-100);
  --color-bg-hover: var(--alpha-black-4);
  --color-bg-pressed: var(--alpha-black-8);
  --color-bg-inverse: var(--neutral-900);
  --color-border-subtle: var(--neutral-100);
  --color-border-default: var(--neutral-200);
  --color-border-strong: var(--neutral-300);
  --color-text-primary: var(--neutral-950);
  --color-text-secondary: var(--neutral-600);
  --color-text-muted: var(--neutral-500);
  --color-text-disabled: var(--neutral-400);
  --color-text-inverse: var(--neutral-0);
  --color-text-on-accent: var(--neutral-0);
  --color-accent-solid: var(--accent-600);
  --color-accent-solid-hover: var(--accent-700);
  --color-accent-subtle: var(--accent-50);
  --color-accent-subtle-hover: var(--accent-100);
  --color-accent-text: var(--accent-700);
  --color-accent-border: var(--accent-300);
  --color-focus-ring: var(--accent-500);
  --color-overlay-scrim: var(--alpha-black-48);
  --color-status-success-solid: var(--success-600);
  --color-status-success-subtle: var(--success-50);
  --color-status-success-text: var(--success-700);
  --color-status-success-border: var(--success-200);
  --color-status-warning-solid: var(--warning-600);
  --color-status-warning-subtle: var(--warning-50);
  --color-status-warning-text: var(--warning-700);
  --color-status-warning-border: var(--warning-200);
  --color-status-danger-solid: var(--danger-600);
  --color-status-danger-subtle: var(--danger-50);
  --color-status-danger-text: var(--danger-700);
  --color-status-danger-border: var(--danger-200);
  --color-status-info-solid: var(--info-600);
  --color-status-info-subtle: var(--info-50);
  --color-status-info-text: var(--info-700);
