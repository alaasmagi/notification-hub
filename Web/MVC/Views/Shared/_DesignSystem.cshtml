/* Dark is the default; light is opt-in via data-theme="light" on <html>. */
:root, [data-theme="dark"] {
  color-scheme: dark;
  --color-bg-canvas: var(--neutral-950);
  --color-bg-surface: var(--neutral-900);
  --color-bg-raised: var(--neutral-850);
  --color-bg-sunken: var(--neutral-1000);
  --color-bg-hover: var(--alpha-white-6);
  --color-bg-pressed: var(--alpha-white-10);
  --color-bg-inverse: var(--neutral-50);
  --color-border-subtle: var(--neutral-850);
  --color-border-default: var(--neutral-800);
  --color-border-strong: var(--neutral-700);
  --color-text-primary: var(--neutral-50);
  --color-text-secondary: var(--neutral-300);
  --color-text-muted: var(--neutral-400);
  --color-text-disabled: var(--neutral-600);
  --color-text-inverse: var(--neutral-950);
  --color-text-on-accent: var(--neutral-950);
  --color-accent-solid: var(--accent-400);
  --color-accent-solid-hover: var(--accent-300);
  --color-accent-subtle: var(--accent-950);
  --color-accent-subtle-hover: var(--accent-900);
  --color-accent-text: var(--accent-300);
  --color-accent-border: var(--accent-700);
  --color-focus-ring: var(--accent-400);
  --color-overlay-scrim: var(--alpha-black-64);
  --color-status-success-solid: var(--success-400);
  --color-status-success-subtle: var(--success-950);
  --color-status-success-text: var(--success-300);
  --color-status-success-border: var(--success-800);
  --color-status-warning-solid: var(--warning-400);
  --color-status-warning-subtle: var(--warning-950);
  --color-status-warning-text: var(--warning-300);
  --color-status-warning-border: var(--warning-800);
  --color-status-danger-solid: var(--danger-400);
  --color-status-danger-subtle: var(--danger-950);
  --color-status-danger-text: var(--danger-300);
  --color-status-danger-border: var(--danger-800);
  --color-status-info-solid: var(--info-400);
  --color-status-info-subtle: var(--info-950);
  --color-status-info-text: var(--info-300);
