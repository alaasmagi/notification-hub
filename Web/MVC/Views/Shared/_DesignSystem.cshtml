}

/* ===== Base ===== */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--color-bg-canvas); color: var(--color-text-primary); font-family: var(--font-sans); font-size: 16px; line-height: 24px; -webkit-font-smoothing: antialiased; }
h1, h2, h3, p, dl, dd, ul, ol { margin: 0; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; color: inherit; }
:focus-visible { outline: var(--border-thick) solid var(--color-focus-ring); outline-offset: 2px; }
.icon { width: 20px; height: 20px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.icon--sm { width: 16px; height: 16px; } .icon--lg { width: 24px; height: 24px; }
.visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.muted { color: var(--color-text-muted); } .secondary { color: var(--color-text-secondary); }
.kicker { font-size: 12px; line-height: 16px; font-weight: 500; letter-spacing: 0.005em; text-transform: uppercase; color: var(--color-accent-text); }
.mono { font-family: var(--font-mono); font-size: 14px; line-height: 20px; }

/* ===== Shell: sidebar + main ===== */
.shell { display: grid; grid-template-columns: 272px minmax(0, 1fr); min-height: 100vh; }
.sidebar { position: sticky; top: 0; display: flex; flex-direction: column; gap: var(--space-1); height: 100vh; padding: var(--space-6) var(--space-5); background: var(--color-bg-surface); border-right: var(--border-thin) solid var(--color-border-subtle); overflow-y: auto; }
.brand { display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--space-2) var(--space-5); font-size: 16px; line-height: 24px; font-weight: 600; }
.brand__mark { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--color-accent-solid); color: var(--color-text-on-accent); font-size: 12px; font-weight: 700; }
.nav { display: flex; flex-direction: column; gap: var(--space-1); }
.nav__group { padding: var(--space-4) var(--space-3) var(--space-1); font-size: 12px; line-height: 16px; font-weight: 500; letter-spacing: 0.005em; text-transform: uppercase; color: var(--color-text-muted); }
.nav-item { display: flex; align-items: center; gap: var(--space-3); min-height: 40px; padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); color: var(--color-text-secondary); font-size: 14px; line-height: 20px; font-weight: 600; }
.nav-item:hover { background: var(--color-bg-hover); color: var(--color-text-primary); }
.nav-item[aria-current="page"] { background: var(--color-accent-subtle); color: var(--color-accent-text); }
.sidebar__spacer { flex: 1; min-height: var(--space-6); }
.sidebar__footer { display: flex; flex-direction: column; gap: var(--space-2); }
.user-row { display: flex; align-items: center; gap: var(--space-2); padding-left: var(--space-2); }
.user-row__email { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; line-height: 20px; color: var(--color-text-secondary); }
.user-row__email:hover { color: var(--color-text-primary); text-decoration: underline; text-underline-offset: 3px; }
.user-row form { margin: 0; }
.sidebar .menu-button { display: none; }
.main { min-width: 0; display: flex; flex-direction: column; }
.content { display: flex; flex-direction: column; gap: var(--space-6); padding: var(--space-10) var(--space-12) var(--space-12); flex: 1; }
.app-footer { display: flex; flex-wrap: wrap; gap: var(--space-2); padding: var(--space-5) var(--space-12); border-top: var(--border-thin) solid var(--color-border-subtle); font-size: 12px; line-height: 16px; color: var(--color-text-muted); }
.app-footer a:hover { color: var(--color-text-primary); text-decoration: underline; }

@@media (max-width: 959px) {
  .shell { grid-template-columns: 1fr; }
  .sidebar { position: sticky; z-index: 20; height: auto; padding: var(--space-3) var(--space-4); border-right: 0; border-bottom: var(--border-thin) solid var(--color-border-subtle); }
  .sidebar__top { display: flex; align-items: center; justify-content: space-between; }
  .brand { padding: 0; }
  .sidebar .menu-button { display: inline-flex; }
  .sidebar .nav, .sidebar .sidebar__spacer, .sidebar .sidebar__footer { display: none; }
  .sidebar.is-open .nav, .sidebar.is-open .sidebar__footer { display: flex; }
  .sidebar.is-open .sidebar__footer { padding-top: var(--space-4); }
  .content { padding: var(--space-6) var(--space-4) var(--space-10); }
  .app-footer { padding: var(--space-4); }
}

/* ===== Page header ===== */
.page-header { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-4); }
.page-header__title { display: flex; flex-direction: column; gap: var(--space-1); max-width: 760px; }
.page-header h1 { font-size: 28px; line-height: 34px; font-weight: 700; letter-spacing: -0.015em; }
.page-header__lede { margin-top: var(--space-1); color: var(--color-text-secondary); }
.page-header__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
@@media (min-width: 1024px) { .page-header h1 { font-size: 36px; line-height: 44px; } }
.section-title { font-size: 18px; line-height: 24px; font-weight: 600; letter-spacing: -0.005em; }
.section { display: flex; flex-direction: column; gap: var(--space-3); }

/* ===== Buttons ===== */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 44px; padding: var(--space-3) var(--space-5); border: var(--border-thin) solid transparent; border-radius: var(--radius-md); background: transparent; font-size: 14px; line-height: 20px; font-weight: 600; white-space: nowrap; cursor: pointer; transition: background-color var(--motion-duration-fast) var(--motion-easing-standard), border-color var(--motion-duration-fast) var(--motion-easing-standard); }
.btn .icon { width: 18px; height: 18px; }
.btn--primary { background: var(--color-accent-solid); color: var(--color-text-on-accent); }
.btn--primary:hover { background: var(--color-accent-solid-hover); }
.btn--secondary { background: var(--color-bg-surface); border-color: var(--color-border-strong); color: var(--color-text-primary); }
.btn--ghost { color: var(--color-text-primary); }
.btn--danger { background: var(--color-status-danger-solid); color: var(--color-text-on-accent); }
.btn--secondary:hover, .btn--ghost:hover { background-image: linear-gradient(var(--color-bg-hover), var(--color-bg-hover)); }
.btn--danger:hover { background-image: linear-gradient(var(--color-bg-pressed), var(--color-bg-pressed)); }
.btn:disabled { cursor: not-allowed; background: var(--color-bg-sunken); color: var(--color-text-disabled); }
.btn--sm { min-height: 36px; padding: var(--space-2) var(--space-3); }
.icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-text-secondary); cursor: pointer; }
.icon-btn:hover { background: var(--color-bg-hover); color: var(--color-text-primary); }
.icon-btn--danger { color: var(--color-status-danger-text); }
.icon-btn--danger:hover { color: var(--color-status-danger-text); }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
.actions form, .row-actions form { margin: 0; display: inline-flex; }

/* ===== Badges / chips ===== */
.badge { display: inline-flex; align-items: center; padding: var(--space-0-5) var(--space-2); border: var(--border-thin) solid; border-radius: var(--radius-full); font-size: 12px; line-height: 16px; font-weight: 500; letter-spacing: 0.005em; white-space: nowrap; }
.badge--neutral { background: var(--color-bg-sunken); border-color: var(--color-border-default); color: var(--color-text-secondary); }
.badge--accent { background: var(--color-accent-subtle); border-color: var(--color-accent-border); color: var(--color-accent-text); }
.badge--success { background: var(--color-status-success-subtle); border-color: var(--color-status-success-border); color: var(--color-status-success-text); }
.badge--warning { background: var(--color-status-warning-subtle); border-color: var(--color-status-warning-border); color: var(--color-status-warning-text); }
.badge--danger { background: var(--color-status-danger-subtle); border-color: var(--color-status-danger-border); color: var(--color-status-danger-text); }
.code-chip { display: inline-block; padding: var(--space-0-5) var(--space-1-5); border: var(--border-thin) solid var(--color-border-subtle); border-radius: var(--radius-xs); background: var(--color-bg-sunken); font-family: var(--font-mono); font-size: 12px; line-height: 16px; overflow-wrap: anywhere; }

/* ===== Alerts ===== */
.alert { display: flex; gap: var(--space-3); padding: var(--space-3) var(--space-4); border: var(--border-thin) solid var(--tone-border); border-radius: var(--radius-md); background: var(--tone-subtle); }
.alert > .icon { color: var(--tone-text); margin-top: 2px; }
.alert__body { display: flex; flex-direction: column; gap: var(--space-0-5); min-width: 0; font-size: 14px; line-height: 20px; }
.alert__title { font-weight: 600; color: var(--tone-text); }
.alert__body ul { padding-left: var(--space-5); }
.alert--success { --tone-subtle: var(--color-status-success-subtle); --tone-border: var(--color-status-success-border); --tone-text: var(--color-status-success-text); }
.alert--warning { --tone-subtle: var(--color-status-warning-subtle); --tone-border: var(--color-status-warning-border); --tone-text: var(--color-status-warning-text); }
.alert--danger { --tone-subtle: var(--color-status-danger-subtle); --tone-border: var(--color-status-danger-border); --tone-text: var(--color-status-danger-text); }
.alert--info { --tone-subtle: var(--color-status-info-subtle); --tone-border: var(--color-status-info-border); --tone-text: var(--color-status-info-text); }
.validation-summary-valid { display: none; }
.validation-summary-errors { padding: var(--space-3) var(--space-4); border: var(--border-thin) solid var(--color-status-danger-border); border-radius: var(--radius-md); background: var(--color-status-danger-subtle); color: var(--color-status-danger-text); font-size: 14px; line-height: 20px; }
.validation-summary-errors ul { padding-left: var(--space-5); }

/* ===== Cards ===== */
.card { background: var(--color-bg-surface); border: var(--border-thin) solid var(--color-border-subtle); border-radius: var(--radius-lg); }
.card--pad { padding: var(--space-6); }
.narrow { width: 100%; max-width: 720px; }
.medium { width: 100%; max-width: 880px; }

/* ===== Forms ===== */
.form { display: flex; flex-direction: column; gap: var(--space-5); padding: var(--space-6); }
.form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
.field { display: flex; flex-direction: column; gap: var(--space-1-5); min-width: 0; }
.field__label { font-size: 14px; line-height: 20px; font-weight: 600; color: var(--color-text-secondary); }
.field__control { position: relative; display: flex; align-items: center; }
.field__control > .icon { position: absolute; left: var(--space-3); color: var(--color-text-muted); pointer-events: none; }
.field__control > .icon--end { left: auto; right: var(--space-3); color: var(--color-text-secondary); }
.input { width: 100%; min-height: 44px; padding: var(--space-2-5) var(--space-3); background: var(--color-bg-sunken); border: var(--border-thin) solid var(--color-border-default); border-radius: var(--radius-md); font-size: 16px; line-height: 24px; color: var(--color-text-primary); transition: border-color var(--motion-duration-fast), background-color var(--motion-duration-fast); }
.input::placeholder { color: var(--color-text-muted); opacity: 1; }
.has-icon .input { padding-left: 40px; }
select.input { appearance: none; -webkit-appearance: none; padding-right: 40px; cursor: pointer; }
.input:focus { outline: none; background: var(--color-bg-surface); border-color: var(--color-accent-solid); box-shadow: 0 0 0 1px var(--color-accent-solid); }
.input:disabled { background: var(--color-bg-canvas); border-color: var(--color-border-subtle); color: var(--color-text-disabled); cursor: not-allowed; }
.input.input-validation-error { border-color: var(--color-status-danger-solid); box-shadow: 0 0 0 1px var(--color-status-danger-solid); }
.field__help { font-size: 12px; line-height: 16px; color: var(--color-text-muted); }
.field-validation-error { font-size: 12px; line-height: 16px; color: var(--color-status-danger-text); }
.field-validation-valid { display: none; }
input[type="date"].input::-webkit-calendar-picker-indicator { opacity: 0.6; cursor: pointer; }
[data-theme="dark"] input[type="date"].input::-webkit-calendar-picker-indicator { filter: invert(1); }
