@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Current(string controller) => string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="color-scheme" content="dark light"/>
    <title>@ViewData["Title"] - Notification Hub</title>
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem("notificationHubTheme"); } catch (e) { }
            if (theme !== "light" && theme !== "dark") {
                theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
            }
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@@400;500;600;700&family=JetBrains+Mono:wght@@400&display=swap"/>
    <partial name="_DesignSystem"/>
</head>
<body>
<partial name="_Icons"/>

@if (signedIn)
{
    <div class="shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar__top">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand__mark" aria-hidden="true">NH</span>
                    <span>Notification Hub</span>
                </a>
                <button class="icon-btn menu-button" type="button" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation" data-menu-toggle>
                    <svg class="icon" aria-hidden="true"><use href="#i-menu"></use></svg>
                </button>
            </div>

            <nav class="nav" id="mainNavigation" aria-label="Main">
                <a class="nav-item" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@Current("Home")">
                    <svg class="icon" aria-hidden="true"><use href="#i-home"></use></svg>Home
                </a>
                <a class="nav-item" asp-area="" asp-controller="Client" asp-action="Index" aria-current="@Current("Client")">
                    <svg class="icon" aria-hidden="true"><use href="#i-server"></use></svg>Clients
                </a>
                <a class="nav-item" asp-area="" asp-controller="SenderIdentity" asp-action="Index" aria-current="@Current("SenderIdentity")">
                    <svg class="icon" aria-hidden="true"><use href="#i-at-sign"></use></svg>Senders
                </a>
                <a class="nav-item" asp-area="" asp-controller="Template" asp-action="Index" aria-current="@Current("Template")">
                    <svg class="icon" aria-hidden="true"><use href="#i-file-code"></use></svg>Templates
                </a>
                <a class="nav-item" asp-area="" asp-controller="Email" asp-action="Index" aria-current="@Current("Email")">
                    <svg class="icon" aria-hidden="true"><use href="#i-mail"></use></svg>Emails
                </a>
            </nav>

            <div class="sidebar__spacer"></div>

            <div class="sidebar__footer">
                <button class="switch" type="button" role="switch" aria-checked="true" data-theme-switch>
                    <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
                    <span>Dark mode</span>
                </button>
                <div class="user-row">
                    <span class="user-row__email" title="@User.Identity!.Name">@User.Identity!.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="icon-btn" aria-label="Logout" title="Logout">
                            <svg class="icon" aria-hidden="true"><use href="#i-log-out"></use></svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="main">
            <main role="main" class="content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                <span>&copy; 2026 Notification Hub</span>
                <span aria-hidden="true">/</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>
}
else
{
    <div class="public">
        <header class="topbar">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand__mark" aria-hidden="true">NH</span>
                <span>Notification Hub</span>
            </a>
            <div class="topbar__actions">
                <button class="switch" type="button" role="switch" aria-checked="true" data-theme-switch>
                    <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
                    <span>Dark mode</span>
                </button>
                @if (currentController != "Home")
                {
                    <a class="btn btn--secondary" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </header>
        <main role="main" class="content">
            @RenderBody()
        </main>
        <footer class="app-footer">
            <span>&copy; 2026 Notification Hub</span>
            <span aria-hidden="true">/</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>
}

@* Confirmation dialog for destructive forms: <form data-confirm="Message" data-confirm-title="Title" data-confirm-label="Delete"> *@
<dialog class="dialog" id="confirmDialog" aria-labelledby="confirmTitle">
    <form method="dialog" class="dialog__panel">
        <div class="dialog__header">
            <h2 class="dialog__title" id="confirmTitle">Are you sure?</h2>
            <button class="icon-btn" value="cancel" aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#i-x"></use></svg></button>
        </div>
        <p class="dialog__body" id="confirmBody"></p>
        <div class="dialog__footer">
            <button class="btn btn--ghost" value="cancel">Cancel</button>
            <button class="btn btn--danger" value="confirm" id="confirmButton">Delete</button>
        </div>
    </form>
</dialog>

<script>
    (() => {
        const root = document.documentElement;
        const switches = document.querySelectorAll("[data-theme-switch]");
        const sync = () => switches.forEach(s => s.setAttribute("aria-checked", String(root.getAttribute("data-theme") === "dark")));
        switches.forEach(s => s.addEventListener("click", () => {
            const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
            root.setAttribute("data-theme", next);
            try { localStorage.setItem("notificationHubTheme", next); } catch (e) { }
            sync();
        }));
        sync();

        const sidebar = document.getElementById("sidebar");
        const menu = document.querySelector("[data-menu-toggle]");
        if (sidebar && menu) {
            menu.addEventListener("click", () => menu.setAttribute("aria-expanded", String(sidebar.classList.toggle("is-open"))));
        }

        const dialog = document.getElementById("confirmDialog");
        document.querySelectorAll("form[data-confirm]").forEach(form => {
            form.addEventListener("submit", event => {
                if (form.dataset.confirmed === "true") return;
                event.preventDefault();
                if (typeof dialog.showModal !== "function") {
                    if (window.confirm(form.dataset.confirm)) { form.dataset.confirmed = "true"; form.submit(); }
                    return;
                }
                document.getElementById("confirmTitle").textContent = form.dataset.confirmTitle || "Are you sure?";
                document.getElementById("confirmBody").textContent = form.dataset.confirm;
                document.getElementById("confirmButton").textContent = form.dataset.confirmLabel || "Delete";
                dialog.returnValue = "";
                dialog.addEventListener("close", () => {
                    if (dialog.returnValue === "confirm") { form.dataset.confirmed = "true"; form.submit(); }
                }, { once: true });
                dialog.showModal();
            });
        });
    })();
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
