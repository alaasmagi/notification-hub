@model IEnumerable<ClientDto>

@{
    ViewData["Title"] = "Clients";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Service mappings</p>
        <h1>Clients</h1>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" asp-action="Create"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Create client</a>
    </div>
</header>

<partial name="_TempDataAlerts"/>

<div class="card table-card">
    <table class="data-table">
        <thead>
        <tr>
            <th>Source</th>
            <th>Display name</th>
            <th>Status</th>
            <th class="actions-col">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var client in Model)
        {
            <tr>
                <td><code class="code-chip">@client.Source</code></td>
                <td>@client.DisplayName</td>
                <td><partial name="_ActiveBadge" model="client.IsActive"/></td>
                <td class="actions-col">
                    <div class="row-actions">
                        <a class="icon-btn" asp-action="Edit" asp-route-id="@client.Id" aria-label="Edit client" title="Edit client"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                        <form asp-action="Delete" asp-route-id="@client.Id" method="post"
                              data-confirm="Email senders and notification types must be deleted first. This action cannot be undone."
                              data-confirm-title="Delete this client?" data-confirm-label="Delete client">
                            <button type="submit" class="icon-btn icon-btn--danger" aria-label="Delete client" title="Delete client"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg></button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="empty">No clients yet.</td></tr>
        }
        </tbody>
    </table>
</div>

<p class="footnote">A client can only be deleted after its email senders and notification types have been removed.</p>
