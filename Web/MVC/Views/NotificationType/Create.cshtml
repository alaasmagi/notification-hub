@model NotificationTypeDto

@{
    ViewData["Title"] = "Create notification type";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Notification types</p>
        <h1>Create notification type</h1>
    </div>
</header>

<form asp-action="Create" method="post" class="card form wide">
    <div asp-validation-summary="ModelOnly"></div>
    <partial name="_Form" model="Model"/>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Create notification type</button>
        <a class="btn btn--ghost" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
