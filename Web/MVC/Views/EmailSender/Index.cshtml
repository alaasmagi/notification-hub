@model IEnumerable<EmailSenderIndexRow>

@{
    ViewData["Title"] = "Email senders";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">From address routing</p>
        <h1>Email senders</h1>
    </div>
    <div class="page-header__actions">
        <a class="btn btn--primary" asp-action="Create"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Create sender</a>
    </div>
</header>

<partial name="_TempDataAlerts"/>

<div class="card table-card">
    <table class="data-table">
        <thead>
        <tr>
            <th>Client source</th>
            <th>Tenant</th>
            <th>From</th>
            <th>Display name</th>
            <th>Reply-to</th>
            <th>Status</th>
            <th class="actions-col">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var sender in Model)
        {
            <tr>
                <td><code class="code-chip">@sender.ClientSource</code></td>
                <td class="mono">@sender.EmailSender.Tenant</td>
                <td>@sender.EmailSender.FromAddress</td>
                <td>@sender.EmailSender.DisplayName</td>
                <td class="secondary">@(string.IsNullOrWhiteSpace(sender.EmailSender.ReplyTo) ? "—" : sender.EmailSender.ReplyTo)</td>
                <td><partial name="_ActiveBadge" model="sender.EmailSender.IsActive"/></td>
                <td class="actions-col">
                    <div class="row-actions">
                        <a class="icon-btn" asp-action="Edit" asp-route-id="@sender.EmailSender.Id" aria-label="Edit email sender" title="Edit email sender"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                        <form asp-action="Delete" asp-route-id="@sender.EmailSender.Id" method="post"
                              data-confirm="This action cannot be undone."
                              data-confirm-title="Delete this email sender?" data-confirm-label="Delete sender">
                            <button type="submit" class="icon-btn icon-btn--danger" aria-label="Delete email sender" title="Delete email sender"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg></button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="empty">No email senders yet.</td></tr>
        }
        </tbody>
    </table>
</div>


