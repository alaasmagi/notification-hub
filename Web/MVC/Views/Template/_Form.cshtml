@model TemplateDto
@{
    var notificationTypes = (IReadOnlyList<NotificationTypeOption>)(ViewBag.NotificationTypes ?? new List<NotificationTypeOption>());
    var selectedNotificationType = notificationTypes.FirstOrDefault(x => x.Id == Model.NotificationTypeId) ?? notificationTypes.FirstOrDefault();
}

<div class="form-row form-row--template">
    <div class="field">
        <label class="field__label" asp-for="NotificationTypeId"></label>
        <div class="field__control">
            <select class="input" id="NotificationTypeId" name="NotificationTypeId">
                @foreach (var notificationType in notificationTypes)
                {
                    <option value="@notificationType.Id" data-service-name="@notificationType.ClientSource" selected="@(notificationType.Id == selectedNotificationType?.Id)">
                        @notificationType.ClientSource — @notificationType.Key
                    </option>
                }
            </select>
            <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </div>
        <span asp-validation-for="NotificationTypeId"></span>
    </div>

    <div class="field">
        <label class="field__label" for="ClientSource">Client source</label>
        <input class="input mono" id="ClientSource" value="@selectedNotificationType?.ClientSource" readonly/>
    </div>

    <div class="field">
        <label class="field__label" asp-for="LanguageCode"></label>
        <input class="input mono" asp-for="LanguageCode" placeholder="e.g. en"/>
        <span asp-validation-for="LanguageCode"></span>
    </div>
</div>

<div class="form-row">
    <div class="field">
        <label class="field__label" asp-for="Channel"></label>
        <div class="field__control">
            <select class="input" asp-for="Channel" asp-items="Html.GetEnumSelectList<EChannel>()"></select>
            <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </div>
        <span asp-validation-for="Channel"></span>
    </div>
    <div class="field">
        <label class="field__label" asp-for="Tenant"></label>
        <input class="input mono" asp-for="Tenant" placeholder="Empty for shared fallback"/>
        <span asp-validation-for="Tenant"></span>
    </div>
</div>

<div class="field">
    <label class="field__label" asp-for="Title"></label>
    <textarea class="input mono" asp-for="Title" rows="3"></textarea>
    <span asp-validation-for="Title"></span>
</div>

<div class="field">
    <label class="field__label" asp-for="Body"></label>
    <textarea class="input mono" asp-for="Body" rows="18" spellcheck="false"></textarea>
    <span asp-validation-for="Body"></span>
</div>

<label class="check">
    <input asp-for="IsActive"/>
    <span>@Html.DisplayNameFor(m => m.IsActive)</span>
</label>

<script>
    (() => {
        const notificationTypeSelect = document.getElementById("NotificationTypeId");
        const sourceInput = document.getElementById("ClientSource");
        if (!notificationTypeSelect || !sourceInput) {
            return;
        }

        const syncSource = () => {
            sourceInput.value = notificationTypeSelect.selectedOptions[0]?.dataset.source || "";
        };

        notificationTypeSelect.addEventListener("change", syncSource);
        syncSource();
    })();
</script>
